{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "ALLOW_ADMIN_BOOTSTRAP",
    "ALLOW_DEMO_SEED",
    "ALLOW_DESTRUCTIVE_SEED",
    "DESTRUCTIVE_DATABASE_CONFIRM",
    "API_URL",
    "AWS_ACCESS_KEY_ID",
    "AWS_REGION",
    "AWS_SECRET_ACCESS_KEY",
    "BREVO_ALLOWED_ORIGINS",
    "BREVO_WEBHOOK_SECRET",
    "BOOTSTRAP_ADMIN_EMAIL",
    "BOOTSTRAP_ADMIN_FIRST_NAME",
    "BOOTSTRAP_ADMIN_LAST_NAME",
    "BOOTSTRAP_ADMIN_PASSWORD",
    "CORS_ALLOWED_ORIGINS",
    "DATABASE_URL",
    "DIRECT_URL",
    "ENCRYPTION_KEY",
    "FRONTEND_URL",
    "GST_API_KEY",
    "JWT_EXPIRES_IN",
    "JWT_SECRET",
    "KEEPALIVE_TOKEN",
    "LANDINGI_WEBHOOK_SECRET",
    "MSG91_AUTH_KEY",
    "MSG91_ALLOWED_ORIGINS",
    "MSG91_OTP_TEMPLATE_ID",
    "NEXT_PUBLIC_ALLOW_AUTH_TEMPLATES",
    "NEXT_PUBLIC_ALLOW_UTILITY_TEMPLATES",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_WHATSAPP_TEXT_ONLY_MVP",
    "NODE_ENV",
    "ORDER_PRICE_BOOK_ID",
    "OTP_HASH_SECRET",
    "PORT",
    "RESEND_API_KEY",
    "RESEND_FROM_EMAIL",
    "RESEND_REPLY_TO",
    "TOTP_ENCRYPTION_KEY",
    "TRUST_PROXY_HOPS",
    "RUN_EMBEDDED_SCHEDULERS",
    "SCHEDULER_INSTANCE_ID",
    "S3_BUCKET_NAME",
    "S3_ENDPOINT",
    "S3_FORCE_PATH_STYLE",
    "S3_PUBLIC_BASE_URL",
    "S3_USE_ACL",
    "WHATSAPP_WEBHOOK_SECRET",
    "DEMO_SEED_PASSWORD"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "dist/**", "!.next/cache/**"]
    },
    "@repo/db#build": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "prisma/**"],
      "outputs": ["dist/**", "node_modules/.prisma/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["PORT"]
    },
    "prisma:generate": {
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "prisma:migrate": {
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "prisma:deploy": {
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "prisma:studio": {
      "cache": false,
      "persistent": true,
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "prisma:seed": {
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "prisma:seed:demo": {
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "prisma:seed:supply-chain": {
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "prisma:reset": {
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    }
  }
}
