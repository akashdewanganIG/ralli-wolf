{
  "name": "@repo/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/client.js",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "exports": {
    ".": {
      "types": "./src/client.ts",
      "default": "./dist/client.js"
    },
    "./permissions": {
      "types": "./src/permissions.ts",
      "default": "./dist/permissions.js"
    },
    "./crypto": {
      "types": "./src/crypto.ts",
      "default": "./dist/crypto.js"
    }
  },
  "scripts": {
    "build": "dotenv -e ../../.env -- prisma generate && tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "prepare": "dotenv -e ../../.env -- prisma generate && tsc -p tsconfig.json",
    "prisma:generate": "dotenv -e ../../.env -- prisma generate",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "prisma:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "prisma:studio": "dotenv -e ../../.env -- prisma studio",
    "prisma:reset": "dotenv -e ../../.env -- tsx prisma/reset-database.ts",
    "prisma:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "prisma:seed:demo": "dotenv -e ../../.env -- tsx prisma/seed-demo.ts",
    "prisma:seed:all-demo": "dotenv -e ../../.env -- tsx prisma/seed-all-sections.ts",
    "prisma:seed:presentation": "dotenv -e ../../.env -- tsx prisma/seed-presentation.ts",
    "prisma:verify:all-demo": "dotenv -e ../../.env -- tsx prisma/verify-all-sections-demo.ts",
    "prisma:seed:supply-chain": "dotenv -e ../../.env -- tsx prisma/seed-supply-chain.ts",
    "prisma:bootstrap-admin": "dotenv -e ../../.env -- tsx prisma/bootstrap-admin.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.21.1",
    "bcryptjs": "^3.0.2"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.2",
    "prisma": "^5.21.1",
    "tsx": "^4.7.0",
    "typescript": "5.9.2"
  }
}
