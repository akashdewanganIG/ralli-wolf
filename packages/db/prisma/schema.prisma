  PURCHASE_ORDER_APPROVED
  PURCHASE_ORDER_REJECTED
  GOODS_RECEIVED
  QC_FAILED
  MATERIAL_SHORTAGE
  GENERAL
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(GENERAL)
  title     String
  message   String
  isRead    Boolean          @default(false) @map("is_read")
  link      String?
  createdAt DateTime         @default(now()) @map("created_at")
  readAt    DateTime?        @map("read_at")

  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

/// One row per user per notification type, written only when someone changes a
/// default. An absent row means "both channels on" — see NOTIFICATION_DEFAULT
/// in the API. Storing only the deviations keeps a new user's preferences
/// correct without a backfill, and keeps the table small.
model NotificationPreference {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  /// Show it in the bell menu.
  inApp     Boolean          @default(true) @map("in_app")
  /// Also send it to the user's email address.
  email     Boolean          @default(true)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@unique([userId, type])
  @@index([userId])
  @@map("notification_preferences")
}

// ================================================================
// SUPPLY CHAIN FOUNDATION
// Shared reference data used by Inventory, Material, WMS, BOM and
// Purchasing modules.
// ================================================================

/// Atomic document-number generator. One row per document family; the
/// counter is bumped by a single `INSERT ... ON CONFLICT DO UPDATE ...
/// RETURNING` in the same transaction as the document it numbers, so two
/// concurrent requests can never be handed the same number.
model NumberSequence {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  prefix      String
  /// Highest number issued for the current period.
  lastValue   Int      @default(0) @map("last_value")
  padding     Int      @default(5)
  /// NONE | YEARLY | MONTHLY — controls the period segment and counter reset.
  resetPeriod String   @default("YEARLY") @map("reset_period")
  periodKey   String?  @map("period_key")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("number_sequences")
}

model UnitOfMeasure {
  id         Int         @id @default(autoincrement())
  code       String      @unique
  name       String
  category   UomCategory
  /// Multiplier that converts 1 of this unit into the category base unit.
  baseFactor Decimal     @default(1) @map("base_factor") @db.Decimal(18, 6)
  isBaseUnit Boolean     @default(false) @map("is_base_unit")
  decimals   Int         @default(2)
  isActive   Boolean     @default(true) @map("is_active")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  products                 Product[]
  stockMovements           StockMovement[]
  bomHeaders               BillOfMaterials[]
  bomComponents            BomComponent[]
  purchaseRequisitionLines PurchaseRequisitionLine[]
  purchaseOrderLines       PurchaseOrderLine[]
  grnLines                 GoodsReceiptLine[]
  materialRequisitionLines MaterialRequisitionLine[]

  @@index([category])
  @@map("units_of_measure")
}

// ================================================================
// MODULE 3 — WAREHOUSE MANAGEMENT (locations, bins, pallets, tasks)
// ================================================================

model Warehouse {
  id                 Int           @id @default(autoincrement())
  code               String        @unique
  name               String
  type               WarehouseType @default(WAREHOUSE)
  addressLine1       String?       @map("address_line1")
  addressLine2       String?       @map("address_line2")
  city               String?
  state              String?
  postalCode         String?       @map("postal_code")
  country            String?       @default("India")
  contactName        String?       @map("contact_name")
  contactPhone       String?       @map("contact_phone")
  contactEmail       String?       @map("contact_email")
  gstNumber          String?       @map("gst_number")
  isActive           Boolean       @default(true) @map("is_active")
  isDefault          Boolean       @default(false) @map("is_default")
  allowNegativeStock Boolean       @default(false) @map("allow_negative_stock")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  images               WarehouseImage[]
  zones                WarehouseZone[]
  bins                 StorageBin[]
  pallets              Pallet[]
  stockBalances        StockBalance[]
  originatedLots       StockLot[]
  stockReservations    StockReservation[]
  reorderRules         ReorderRule[]
  stockAlerts          StockAlert[]
  stockCounts          StockCount[]
  movementsFrom        StockMovement[]       @relation("MovementFromWarehouse")
  movementsTo          StockMovement[]       @relation("MovementToWarehouse")
  putawayTasks         PutawayTask[]
  pickLists            PickList[]
  purchaseRequisitions PurchaseRequisition[]
  purchaseOrders       PurchaseOrder[]
  goodsReceiptNotes    GoodsReceiptNote[]
  materialRequisitions MaterialRequisition[]
  productionOrders     ProductionOrder[]

  @@index([isActive])
  @@map("warehouses")
}

model WarehouseImage {
  id          Int       @id @default(autoincrement())
  warehouseId Int       @map("warehouse_id")
  url         String
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([warehouseId, sortOrder])
  @@map("warehouse_images")
}

model WarehouseZone {
  id                    Int      @id @default(autoincrement())
  warehouseId           Int      @map("warehouse_id")
  code                  String
  name                  String
  zoneType              ZoneType @default(STORAGE) @map("zone_type")
  temperatureControlled Boolean  @default(false) @map("temperature_controlled")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  warehouse Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  bins      StorageBin[]

  @@unique([warehouseId, code])
  @@index([zoneType])
  @@map("warehouse_zones")
}

model StorageBin {
  id           Int      @id @default(autoincrement())
  warehouseId  Int      @map("warehouse_id")
  zoneId       Int      @map("zone_id")
  code         String
  aisle        String?
  rack         String?
  level        String?
  position     String?
  binType      BinType  @default(SHELF) @map("bin_type")
  /// Traversal order used to sequence pick and putaway tasks.
  pickSequence Int      @default(0) @map("pick_sequence")
  maxWeightKg  Decimal? @map("max_weight_kg") @db.Decimal(18, 4)
  maxVolumeM3  Decimal? @map("max_volume_m3") @db.Decimal(18, 6)
  isPickFace   Boolean  @default(false) @map("is_pick_face")
  isReceiving  Boolean  @default(false) @map("is_receiving")
  isShipping   Boolean  @default(false) @map("is_shipping")
  isQuarantine Boolean  @default(false) @map("is_quarantine")
  isBlocked    Boolean  @default(false) @map("is_blocked")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  warehouse       Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  zone            WarehouseZone      @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  stockBalances   StockBalance[]
  pallets         Pallet[]
  stockCountLines StockCountLine[]
  movementsFrom   StockMovement[]    @relation("MovementFromBin")
  movementsTo     StockMovement[]    @relation("MovementToBin")
  putawayFrom     PutawayTask[]      @relation("PutawayFromBin")
  putawayTo       PutawayTask[]      @relation("PutawayToBin")
  pickTasks       PickTask[]
  grnLines        GoodsReceiptLine[]

  @@unique([warehouseId, code])
  @@index([zoneId])
  @@index([pickSequence])
  @@map("storage_bins")
}

model Pallet {
  id            Int          @id @default(autoincrement())
  code          String       @unique
  warehouseId   Int          @map("warehouse_id")
  binId         Int?         @map("bin_id")
  status        PalletStatus @default(EMPTY)
  grossWeightKg Decimal?     @map("gross_weight_kg") @db.Decimal(18, 4)
  notes         String?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  warehouse     Warehouse      @relation(fields: [warehouseId], references: [id])
  bin           StorageBin?    @relation(fields: [binId], references: [id])
  stockBalances StockBalance[]
  packages      Package[]

  @@index([warehouseId, status])
  @@map("pallets")
}

// ================================================================
// MODULE 1 & 2 — INVENTORY / MATERIAL: lots, balances, ledger
// ================================================================

/// A single receipt layer. Carries the batch/serial identity, the expiry
/// used by FEFO and the unit cost used by FIFO/LIFO/weighted-average
/// valuation. Every quantity in stock belongs to exactly one lot.
model StockLot {
  id                Int       @id @default(autoincrement())
  lotNumber         String    @unique @map("lot_number")
  productId         Int       @map("product_id")
  /// Where the layer was first received. Physical location always comes from
  /// `stock_balances`, because a lot can be split across warehouses by a
  /// transfer without losing its cost or expiry identity.
  originWarehouseId Int       @map("origin_warehouse_id")
  batchNumber       String?   @map("batch_number")
  serialNumber      String?   @map("serial_number")
  manufacturedDate  DateTime? @map("manufactured_date")
  expiryDate        DateTime? @map("expiry_date")
  receivedAt        DateTime  @default(now()) @map("received_at")
  originalQuantity  Decimal   @map("original_quantity") @db.Decimal(18, 4)
  remainingQuantity Decimal   @map("remaining_quantity") @db.Decimal(18, 4)
  unitCost          Decimal   @map("unit_cost") @db.Decimal(18, 4)
  status            LotStatus @default(ACTIVE)
  supplierId        Int?      @map("supplier_id")
  sourceType        String    @map("source_type")
  sourceReference   String?   @map("source_reference")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  product               Product                      @relation(fields: [productId], references: [id])
  originWarehouse       Warehouse                    @relation(fields: [originWarehouseId], references: [id])
  supplier              Supplier?                    @relation(fields: [supplierId], references: [id])
  balances              StockBalance[]
  movements             StockMovement[]
  reservations          StockReservation[]
  grnLines              GoodsReceiptLine[]
  putawayTasks          PutawayTask[]
  pickTasks             PickTask[]
  packageLines          PackageLine[]
  stockCountLines       StockCountLine[]
  productionConsumption ProductionOrderConsumption[]

  @@index([productId, status])
  @@index([expiryDate])
  @@index([receivedAt])
  @@index([serialNumber])
  @@index([batchNumber])
  @@map("stock_lots")
}

/// On-hand quantity for one (product, warehouse, bin, lot, pallet) slot.
/// `reservedQuantity` is soft-allocated stock; available = quantity - reserved.
model StockBalance {
  id               Int         @id @default(autoincrement())
  productId        Int         @map("product_id")
  warehouseId      Int         @map("warehouse_id")
  binId            Int         @map("bin_id")
  lotId            Int         @map("lot_id")
  palletId         Int?        @map("pallet_id")
  quantity         Decimal     @default(0) @db.Decimal(18, 4)
  reservedQuantity Decimal     @default(0) @map("reserved_quantity") @db.Decimal(18, 4)
  status           StockStatus @default(AVAILABLE)
  lastMovementAt   DateTime?   @map("last_movement_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  product   Product    @relation(fields: [productId], references: [id])
  warehouse Warehouse  @relation(fields: [warehouseId], references: [id])
  bin       StorageBin @relation(fields: [binId], references: [id])
  lot       StockLot   @relation(fields: [lotId], references: [id])
  pallet    Pallet?    @relation(fields: [palletId], references: [id])

  @@index([productId, warehouseId])
  @@index([warehouseId, binId])
  @@index([lotId])
  @@index([status])
  @@map("stock_balances")
}

/// Immutable ledger. Every change to `stock_balances` writes one row here,
/// so on-hand can always be reconciled against the movement history.
model StockMovement {
  id              Int               @id @default(autoincrement())
  movementNumber  String            @unique @map("movement_number")
  movementType    StockMovementType @map("movement_type")
  direction       MovementDirection
  productId       Int               @map("product_id")
  lotId           Int?              @map("lot_id")
  uomId           Int?              @map("uom_id")
  quantity        Decimal           @db.Decimal(18, 4)
  unitCost        Decimal           @default(0) @map("unit_cost") @db.Decimal(18, 4)
  totalCost       Decimal           @default(0) @map("total_cost") @db.Decimal(18, 4)
  fromWarehouseId Int?              @map("from_warehouse_id")
  fromBinId       Int?              @map("from_bin_id")
  toWarehouseId   Int?              @map("to_warehouse_id")
  toBinId         Int?              @map("to_bin_id")
  referenceType   String?           @map("reference_type")
  referenceId     Int?              @map("reference_id")
  referenceNumber String?           @map("reference_number")
  reasonCode      String?           @map("reason_code")
  notes           String?
  performedById   Int?              @map("performed_by_id")
  occurredAt      DateTime          @default(now()) @map("occurred_at")
  reversalOfId    Int?              @unique @map("reversal_of_id")
  createdAt       DateTime          @default(now()) @map("created_at")

  product       Product        @relation(fields: [productId], references: [id])
  lot           StockLot?      @relation(fields: [lotId], references: [id])
  uom           UnitOfMeasure? @relation(fields: [uomId], references: [id])
  fromWarehouse Warehouse?     @relation("MovementFromWarehouse", fields: [fromWarehouseId], references: [id])
  fromBin       StorageBin?    @relation("MovementFromBin", fields: [fromBinId], references: [id])
  toWarehouse   Warehouse?     @relation("MovementToWarehouse", fields: [toWarehouseId], references: [id])
  toBin         StorageBin?    @relation("MovementToBin", fields: [toBinId], references: [id])
  performedBy   User?          @relation("StockMovementPerformedBy", fields: [performedById], references: [id])
  reversalOf    StockMovement? @relation("MovementReversal", fields: [reversalOfId], references: [id])
  reversedBy    StockMovement? @relation("MovementReversal")

  @@index([productId, occurredAt])
  @@index([movementType])
  @@index([referenceType, referenceId])
  @@index([occurredAt])
  @@map("stock_movements")
}

/// Soft allocation of stock to a demand document. Reservations never move
/// quantity; they raise `stock_balances.reserved_quantity` so the same units
/// cannot be promised twice.
model StockReservation {
  id               Int                      @id @default(autoincrement())
  productId        Int                      @map("product_id")
  warehouseId      Int                      @map("warehouse_id")
  lotId            Int?                     @map("lot_id")
  quantity         Decimal                  @db.Decimal(18, 4)
  releasedQuantity Decimal                  @default(0) @map("released_quantity") @db.Decimal(18, 4)
  status           ReservationStatus        @default(ACTIVE)
  referenceType    ReservationReferenceType @map("reference_type")
  referenceId      Int                      @map("reference_id")
  referenceNumber  String?                  @map("reference_number")
  expiresAt        DateTime?                @map("expires_at")
  createdById      Int?                     @map("created_by_id")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  lot       StockLot? @relation(fields: [lotId], references: [id])
  createdBy User?     @relation("StockReservationCreatedBy", fields: [createdById], references: [id])

  @@index([productId, warehouseId, status])
  @@index([referenceType, referenceId])
  @@map("stock_reservations")
}

/// Per (product, warehouse) replenishment policy. Drives reorder alerts and
/// the safety-stock thresholds used by material planning.
model ReorderRule {
  id                  Int       @id @default(autoincrement())
  productId           Int       @map("product_id")
  warehouseId         Int       @map("warehouse_id")
  safetyStock         Decimal   @default(0) @map("safety_stock") @db.Decimal(18, 4)
  reorderPoint        Decimal   @default(0) @map("reorder_point") @db.Decimal(18, 4)
  reorderQuantity     Decimal   @default(0) @map("reorder_quantity") @db.Decimal(18, 4)
  maximumStock        Decimal?  @map("maximum_stock") @db.Decimal(18, 4)
  leadTimeDays        Int       @default(0) @map("lead_time_days")
  /// When true, breaching the reorder point creates a purchase requisition
  /// automatically instead of only raising an alert.
  autoRequisition     Boolean   @default(false) @map("auto_requisition")
  preferredSupplierId Int?      @map("preferred_supplier_id")
  isActive            Boolean   @default(true) @map("is_active")
  lastEvaluatedAt     DateTime? @map("last_evaluated_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse         Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  preferredSupplier Supplier? @relation(fields: [preferredSupplierId], references: [id])

  @@unique([productId, warehouseId])
  @@index([isActive])
  @@map("reorder_rules")
}

model StockAlert {
  id                Int            @id @default(autoincrement())
  productId         Int            @map("product_id")
  warehouseId       Int            @map("warehouse_id")
  alertType         StockAlertType @map("alert_type")
  severity          AlertSeverity  @default(MEDIUM)
  status            AlertStatus    @default(OPEN)
  currentQuantity   Decimal        @map("current_quantity") @db.Decimal(18, 4)
  thresholdQuantity Decimal        @map("threshold_quantity") @db.Decimal(18, 4)
  shortfallQuantity Decimal        @default(0) @map("shortfall_quantity") @db.Decimal(18, 4)
  message           String
  lotId             Int?           @map("lot_id")
  acknowledgedById  Int?           @map("acknowledged_by_id")
  acknowledgedAt    DateTime?      @map("acknowledged_at")
  resolvedAt        DateTime?      @map("resolved_at")
  resolutionNote    String?        @map("resolution_note")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  acknowledgedBy User?     @relation("StockAlertAcknowledgedBy", fields: [acknowledgedById], references: [id])

  @@index([status, severity])
  @@index([productId, warehouseId, alertType])
  @@map("stock_alerts")
}

model StockCount {
  id            Int              @id @default(autoincrement())
  countNumber   String           @unique @map("count_number")
  warehouseId   Int              @map("warehouse_id")
  countType     StockCountType   @default(CYCLE) @map("count_type")
  status        StockCountStatus @default(DRAFT)
  scheduledDate DateTime?        @map("scheduled_date")
  startedAt     DateTime?        @map("started_at")
  completedAt   DateTime?        @map("completed_at")
  countedById   Int?             @map("counted_by_id")
  approvedById  Int?             @map("approved_by_id")
  notes         String?
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  warehouse  Warehouse        @relation(fields: [warehouseId], references: [id])
  countedBy  User?            @relation("StockCountCountedBy", fields: [countedById], references: [id])
  approvedBy User?            @relation("StockCountApprovedBy", fields: [approvedById], references: [id])
  lines      StockCountLine[]

  @@index([warehouseId, status])
  @@map("stock_counts")
}

model StockCountLine {
  id               Int      @id @default(autoincrement())
  stockCountId     Int      @map("stock_count_id")
  productId        Int      @map("product_id")
  binId            Int      @map("bin_id")
  lotId            Int?     @map("lot_id")
  systemQuantity   Decimal  @map("system_quantity") @db.Decimal(18, 4)
  countedQuantity  Decimal? @map("counted_quantity") @db.Decimal(18, 4)
  varianceQuantity Decimal  @default(0) @map("variance_quantity") @db.Decimal(18, 4)
  varianceValue    Decimal  @default(0) @map("variance_value") @db.Decimal(18, 4)
  reasonCode       String?  @map("reason_code")
  isPosted         Boolean  @default(false) @map("is_posted")
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  stockCount StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])
  bin        StorageBin @relation(fields: [binId], references: [id])
  lot        StockLot?  @relation(fields: [lotId], references: [id])

  @@index([stockCountId])
  @@map("stock_count_lines")
}

// ================================================================
// MODULE 3 — WMS OPERATIONS: putaway, picking, packing
// ================================================================

model PutawayTask {
  id            Int        @id @default(autoincrement())
  taskNumber    String     @unique @map("task_number")
  warehouseId   Int        @map("warehouse_id")
  productId     Int        @map("product_id")
  lotId         Int        @map("lot_id")
  fromBinId     Int        @map("from_bin_id")
  toBinId       Int?       @map("to_bin_id")
  quantity      Decimal    @db.Decimal(18, 4)
  movedQuantity Decimal    @default(0) @map("moved_quantity") @db.Decimal(18, 4)
  status        TaskStatus @default(PENDING)
  priority      Int        @default(5)
  grnLineId     Int?       @map("grn_line_id")
  assignedToId  Int?       @map("assigned_to_id")
  completedById Int?       @map("completed_by_id")
  completedAt   DateTime?  @map("completed_at")
  notes         String?
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id])
  product     Product           @relation(fields: [productId], references: [id])
  lot         StockLot          @relation(fields: [lotId], references: [id])
  fromBin     StorageBin        @relation("PutawayFromBin", fields: [fromBinId], references: [id])
  toBin       StorageBin?       @relation("PutawayToBin", fields: [toBinId], references: [id])
  grnLine     GoodsReceiptLine? @relation(fields: [grnLineId], references: [id])
  assignedTo  User?             @relation("PutawayAssignedTo", fields: [assignedToId], references: [id])
  completedBy User?             @relation("PutawayCompletedBy", fields: [completedById], references: [id])

  @@index([warehouseId, status])
  @@index([assignedToId, status])
  @@map("putaway_tasks")
}

model PickList {
  id              Int             @id @default(autoincrement())
  pickListNumber  String          @unique @map("pick_list_number")
  warehouseId     Int             @map("warehouse_id")
  status          PickListStatus  @default(DRAFT)
  strategy        PickingStrategy @default(FIFO)
  referenceType   String          @map("reference_type")
  referenceId     Int             @map("reference_id")
  referenceNumber String?         @map("reference_number")
  assignedToId    Int?            @map("assigned_to_id")
  releasedById    Int?            @map("released_by_id")
  releasedAt      DateTime?       @map("released_at")
  completedAt     DateTime?       @map("completed_at")
  notes           String?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  warehouse  Warehouse  @relation(fields: [warehouseId], references: [id])
  assignedTo User?      @relation("PickListAssignedTo", fields: [assignedToId], references: [id])
  releasedBy User?      @relation("PickListReleasedBy", fields: [releasedById], references: [id])
  tasks      PickTask[]
  packages   Package[]

  @@index([warehouseId, status])
  @@index([referenceType, referenceId])
  @@map("pick_lists")
}

model PickTask {
  id                Int        @id @default(autoincrement())
  pickListId        Int        @map("pick_list_id")
  productId         Int        @map("product_id")
  lotId             Int        @map("lot_id")
  binId             Int        @map("bin_id")
  sequence          Int        @default(0)
  requestedQuantity Decimal    @map("requested_quantity") @db.Decimal(18, 4)
  pickedQuantity    Decimal    @default(0) @map("picked_quantity") @db.Decimal(18, 4)
  shortQuantity     Decimal    @default(0) @map("short_quantity") @db.Decimal(18, 4)
  status            TaskStatus @default(PENDING)
  pickedById        Int?       @map("picked_by_id")
  pickedAt          DateTime?  @map("picked_at")
  notes             String?
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  pickList     PickList      @relation(fields: [pickListId], references: [id], onDelete: Cascade)
  product      Product       @relation(fields: [productId], references: [id])
  lot          StockLot      @relation(fields: [lotId], references: [id])
  bin          StorageBin    @relation(fields: [binId], references: [id])
  pickedBy     User?         @relation("PickTaskPickedBy", fields: [pickedById], references: [id])
  packageLines PackageLine[]

  @@index([pickListId, sequence])
  @@index([status])
  @@map("pick_tasks")
}

model Package {
  id             Int           @id @default(autoincrement())
  packageNumber  String        @unique @map("package_number")
  pickListId     Int           @map("pick_list_id")
  palletId       Int?          @map("pallet_id")
  status         PackageStatus @default(OPEN)
  grossWeightKg  Decimal?      @map("gross_weight_kg") @db.Decimal(18, 4)
  lengthCm       Decimal?      @map("length_cm") @db.Decimal(18, 2)
  widthCm        Decimal?      @map("width_cm") @db.Decimal(18, 2)
  heightCm       Decimal?      @map("height_cm") @db.Decimal(18, 2)
  trackingNumber String?       @map("tracking_number")
  carrier        String?
  packedById     Int?          @map("packed_by_id")
  packedAt       DateTime?     @map("packed_at")
  shippedAt      DateTime?     @map("shipped_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  pickList PickList      @relation(fields: [pickListId], references: [id], onDelete: Cascade)
  pallet   Pallet?       @relation(fields: [palletId], references: [id])
  packedBy User?         @relation("PackagePackedBy", fields: [packedById], references: [id])
  lines    PackageLine[]

  @@index([pickListId])
  @@map("packages")
}

model PackageLine {
  id         Int      @id @default(autoincrement())
  packageId  Int      @map("package_id")
  pickTaskId Int      @map("pick_task_id")
  productId  Int      @map("product_id")
  lotId      Int      @map("lot_id")
  quantity   Decimal  @db.Decimal(18, 4)
  createdAt  DateTime @default(now()) @map("created_at")

  package  Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  pickTask PickTask @relation(fields: [pickTaskId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])
  lot      StockLot @relation(fields: [lotId], references: [id])

  @@index([packageId])
  @@map("package_lines")
}

// ================================================================
// MODULE 4 — BILL OF MATERIALS
// ================================================================

model BillOfMaterials {
  id                Int       @id @default(autoincrement())
  bomNumber         String    @unique @map("bom_number")
  productId         Int       @map("product_id")
  name              String
  version           Int       @default(1)
  revision          String    @default("A")
  status            BomStatus @default(DRAFT)
  isDefault         Boolean   @default(false) @map("is_default")
  /// Quantity of the parent product produced by one run of this BOM.
  outputQuantity    Decimal   @default(1) @map("output_quantity") @db.Decimal(18, 4)
  uomId             Int?      @map("uom_id")
  effectiveFrom     DateTime? @map("effective_from")
  effectiveTo       DateTime? @map("effective_to")
  /// Rolled-up material cost of one output unit, recomputed from the
  /// component tree — never entered by hand.
  rolledUpCost      Decimal?  @map("rolled_up_cost") @db.Decimal(18, 4)
  costedAt          DateTime? @map("costed_at")
  laborCost         Decimal   @default(0) @map("labor_cost") @db.Decimal(18, 4)
  overheadCost      Decimal   @default(0) @map("overhead_cost") @db.Decimal(18, 4)
  notes             String?
  previousVersionId Int?      @unique @map("previous_version_id")
  createdById       Int       @map("created_by_id")
  approvedById      Int?      @map("approved_by_id")
  approvedAt        DateTime? @map("approved_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  product          Product           @relation("BomProduct", fields: [productId], references: [id])
  uom              UnitOfMeasure?    @relation(fields: [uomId], references: [id])
  createdBy        User              @relation("BomCreatedBy", fields: [createdById], references: [id])
  approvedBy       User?             @relation("BomApprovedBy", fields: [approvedById], references: [id])
  previousVersion  BillOfMaterials?  @relation("BomVersionChain", fields: [previousVersionId], references: [id])
  nextVersion      BillOfMaterials?  @relation("BomVersionChain")
  components       BomComponent[]
  changeLogs       BomChangeLog[]
  productionOrders ProductionOrder[]

  @@unique([productId, version])
  @@index([status])
  @@index([productId, isDefault])
  @@map("bills_of_materials")
}

model BomComponent {
  id                  Int      @id @default(autoincrement())
  bomId               Int      @map("bom_id")
  componentProductId  Int      @map("component_product_id")
  lineNumber          Int      @default(0) @map("line_number")
  quantity            Decimal  @db.Decimal(18, 4)
  uomId               Int?     @map("uom_id")
  /// Expected process loss as a percentage; planning inflates demand by it.
  scrapPercent        Decimal  @default(0) @map("scrap_percent") @db.Decimal(7, 4)
  isOptional          Boolean  @default(false) @map("is_optional")
  /// Phantom assemblies are exploded through without being stocked.
  isPhantom           Boolean  @default(false) @map("is_phantom")
  operationSequence   Int?     @map("operation_sequence")
  referenceDesignator String?  @map("reference_designator")
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  bom              BillOfMaterials          @relation(fields: [bomId], references: [id], onDelete: Cascade)
  componentProduct Product                  @relation("BomComponentProduct", fields: [componentProductId], references: [id])
  uom              UnitOfMeasure?           @relation(fields: [uomId], references: [id])
  substitutes      BomComponentSubstitute[]

  @@unique([bomId, componentProductId])
  @@index([componentProductId])
  @@map("bom_components")
}

model BomComponentSubstitute {
  id                  Int      @id @default(autoincrement())
  bomComponentId      Int      @map("bom_component_id")
  substituteProductId Int      @map("substitute_product_id")
  priority            Int      @default(1)
  /// Units of the substitute needed per unit of the original component.
  conversionFactor    Decimal  @default(1) @map("conversion_factor") @db.Decimal(18, 6)
  isActive            Boolean  @default(true) @map("is_active")
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  bomComponent      BomComponent @relation(fields: [bomComponentId], references: [id], onDelete: Cascade)
  substituteProduct Product      @relation("BomSubstituteProduct", fields: [substituteProductId], references: [id])

  @@unique([bomComponentId, substituteProductId])
  @@map("bom_component_substitutes")
}

model BomChangeLog {
  id          Int           @id @default(autoincrement())
  bomId       Int           @map("bom_id")
  changeType  BomChangeType @map("change_type")
  fieldName   String?       @map("field_name")
  oldValue    String?       @map("old_value")
  newValue    String?       @map("new_value")
  description String
  reason      String?
  changedById Int           @map("changed_by_id")
  createdAt   DateTime      @default(now()) @map("created_at")

  bom       BillOfMaterials @relation(fields: [bomId], references: [id], onDelete: Cascade)
  changedBy User            @relation("BomChangeChangedBy", fields: [changedById], references: [id])

  @@index([bomId, createdAt])
  @@map("bom_change_logs")
}

// ================================================================
// MODULE 5 — PURCHASING & SUPPLIER MANAGEMENT
// ================================================================

model Supplier {
  id                Int            @id @default(autoincrement())
  code              String         @unique
  name              String
  legalName         String?        @map("legal_name")
  status            SupplierStatus @default(DRAFT)
  email             String?
  phone             String?
  countryCode       String?        @default("91") @map("country_code")
  website           String?
  gstNumber         String?        @map("gst_number")
  panNumber         String?        @map("pan_number")
  addressLine1      String?        @map("address_line1")
  addressLine2      String?        @map("address_line2")
  city              String?
  state             String?
  postalCode        String?        @map("postal_code")
  country           String?        @default("India")
  currencyCode      String         @default("INR") @map("currency_code")
  paymentTerms      String?        @map("payment_terms")
  creditDays        Int            @default(0) @map("credit_days")
  incoterms         String?
  leadTimeDays      Int            @default(0) @map("lead_time_days")
  minOrderValue     Decimal?       @map("min_order_value") @db.Decimal(18, 2)
  bankName          String?        @map("bank_name")
  bankAccountNumber String?        @map("bank_account_number")
  bankIfsc          String?        @map("bank_ifsc")
  notes             String?
  isBlacklisted     Boolean        @default(false) @map("is_blacklisted")
  blacklistReason   String?        @map("blacklist_reason")
  createdById       Int?           @map("created_by_id")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  createdBy            User?                 @relation("SupplierCreatedBy", fields: [createdById], references: [id])
  contacts             SupplierContact[]
  supplierProducts     SupplierProduct[]
  purchaseOrders       PurchaseOrder[]
  purchaseRequisitions PurchaseRequisition[]
  goodsReceiptNotes    GoodsReceiptNote[]
  performanceSnapshots SupplierPerformance[]
  reorderRules         ReorderRule[]
  stockLots            StockLot[]

  @@index([status])
  @@index([name])
  @@map("suppliers")
}

model SupplierContact {
  id          Int      @id @default(autoincrement())
  supplierId  Int      @map("supplier_id")
  name        String
  designation String?
  email       String?
  phone       String?
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@map("supplier_contacts")
}

/// Vendor catalogue entry: what a supplier charges for an item, with the
/// validity window used to pick the price in force on the order date.
model SupplierProduct {
  id               Int       @id @default(autoincrement())
  supplierId       Int       @map("supplier_id")
  productId        Int       @map("product_id")
  supplierSku      String?   @map("supplier_sku")
  unitPrice        Decimal   @map("unit_price") @db.Decimal(18, 4)
  currencyCode     String    @default("INR") @map("currency_code")
  minOrderQuantity Decimal   @default(1) @map("min_order_quantity") @db.Decimal(18, 4)
  packSize         Decimal   @default(1) @map("pack_size") @db.Decimal(18, 4)
  leadTimeDays     Int       @default(0) @map("lead_time_days")
  validFrom        DateTime  @default(now()) @map("valid_from")
  validTo          DateTime? @map("valid_to")
  isPreferred      Boolean   @default(false) @map("is_preferred")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  supplier   Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product    Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceTiers SupplierPriceTier[]

  @@unique([supplierId, productId, validFrom])
  @@index([productId, isActive])
  @@map("supplier_products")
}

model SupplierPriceTier {
  id                Int      @id @default(autoincrement())
  supplierProductId Int      @map("supplier_product_id")
  minQuantity       Decimal  @map("min_quantity") @db.Decimal(18, 4)
  unitPrice         Decimal  @map("unit_price") @db.Decimal(18, 4)
  createdAt         DateTime @default(now()) @map("created_at")

  supplierProduct SupplierProduct @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)

  @@unique([supplierProductId, minQuantity])
  @@map("supplier_price_tiers")
}

/// Period snapshot of supplier KPIs. Every figure is derived from posted
/// purchase orders and goods receipts by `supplierPerformance.service`.
model SupplierPerformance {
  id                    Int      @id @default(autoincrement())
  supplierId            Int      @map("supplier_id")
  periodStart           DateTime @map("period_start")
  periodEnd             DateTime @map("period_end")
  totalOrders           Int      @default(0) @map("total_orders")
  totalOrderValue       Decimal  @default(0) @map("total_order_value") @db.Decimal(18, 2)
  receiptsCount         Int      @default(0) @map("receipts_count")
  onTimeReceipts        Int      @default(0) @map("on_time_receipts")
  lateReceipts          Int      @default(0) @map("late_receipts")
  onTimeDeliveryRate    Decimal  @default(0) @map("on_time_delivery_rate") @db.Decimal(7, 4)
  receivedQuantity      Decimal  @default(0) @map("received_quantity") @db.Decimal(18, 4)
  acceptedQuantity      Decimal  @default(0) @map("accepted_quantity") @db.Decimal(18, 4)
  rejectedQuantity      Decimal  @default(0) @map("rejected_quantity") @db.Decimal(18, 4)
  qualityAcceptanceRate Decimal  @default(0) @map("quality_acceptance_rate") @db.Decimal(7, 4)
  averageLeadTimeDays   Decimal  @default(0) @map("average_lead_time_days") @db.Decimal(10, 2)
  priceVariancePercent  Decimal  @default(0) @map("price_variance_percent") @db.Decimal(10, 4)
  fillRate              Decimal  @default(0) @map("fill_rate") @db.Decimal(7, 4)
  overallScore          Decimal  @default(0) @map("overall_score") @db.Decimal(7, 4)
  computedAt            DateTime @default(now()) @map("computed_at")

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, periodStart, periodEnd])
  @@index([supplierId, computedAt])
  @@map("supplier_performance")
}

model PurchaseRequisition {
  id                  Int                       @id @default(autoincrement())
  requisitionNumber   String                    @unique @map("requisition_number")
  warehouseId         Int                       @map("warehouse_id")
  status              PurchaseRequisitionStatus @default(DRAFT)
  /// MANUAL | REORDER_RULE | MATERIAL_SHORTAGE — where the demand came from.
  origin              String                    @default("MANUAL")
  requiredByDate      DateTime?                 @map("required_by_date")
  suggestedSupplierId Int?                      @map("suggested_supplier_id")
  estimatedValue      Decimal                   @default(0) @map("estimated_value") @db.Decimal(18, 2)
  justification       String?
  requestedById       Int                       @map("requested_by_id")
  approvedById        Int?                      @map("approved_by_id")
  approvedAt          DateTime?                 @map("approved_at")
  rejectionReason     String?                   @map("rejection_reason")
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")

  warehouse         Warehouse                 @relation(fields: [warehouseId], references: [id])
  suggestedSupplier Supplier?                 @relation(fields: [suggestedSupplierId], references: [id])
  requestedBy       User                      @relation("RequisitionRequestedBy", fields: [requestedById], references: [id])
  approvedBy        User?                     @relation("RequisitionApprovedBy", fields: [approvedById], references: [id])
  lines             PurchaseRequisitionLine[]
  purchaseOrders    PurchaseOrder[]

  @@index([status])
  @@index([warehouseId])
  @@map("purchase_requisitions")
}

model PurchaseRequisitionLine {
  id                 Int       @id @default(autoincrement())
  requisitionId      Int       @map("requisition_id")
  productId          Int       @map("product_id")
  quantity           Decimal   @db.Decimal(18, 4)
  orderedQuantity    Decimal   @default(0) @map("ordered_quantity") @db.Decimal(18, 4)
  uomId              Int?      @map("uom_id")
  estimatedUnitPrice Decimal   @default(0) @map("estimated_unit_price") @db.Decimal(18, 4)
  requiredByDate     DateTime? @map("required_by_date")
  notes              String?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  requisition PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  product     Product             @relation(fields: [productId], references: [id])
  uom         UnitOfMeasure?      @relation(fields: [uomId], references: [id])
  poLines     PurchaseOrderLine[]

  @@index([requisitionId])
  @@map("purchase_requisition_lines")
}

model PurchaseOrder {
  id                   Int                 @id @default(autoincrement())
  poNumber             String              @unique @map("po_number")
  supplierId           Int                 @map("supplier_id")
  warehouseId          Int                 @map("warehouse_id")
  requisitionId        Int?                @map("requisition_id")
  status               PurchaseOrderStatus @default(DRAFT)
  orderDate            DateTime            @default(now()) @map("order_date")
  expectedDeliveryDate DateTime?           @map("expected_delivery_date")
  promisedDate         DateTime?           @map("promised_date")
  currencyCode         String              @default("INR") @map("currency_code")
  exchangeRate         Decimal             @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  subtotal             Decimal             @default(0) @db.Decimal(18, 2)
  discountAmount       Decimal             @default(0) @map("discount_amount") @db.Decimal(18, 2)
  taxAmount            Decimal             @default(0) @map("tax_amount") @db.Decimal(18, 2)
  shippingAmount       Decimal             @default(0) @map("shipping_amount") @db.Decimal(18, 2)
  grandTotal           Decimal             @default(0) @map("grand_total") @db.Decimal(18, 2)
  paymentTerms         String?             @map("payment_terms")
  incoterms            String?
  shipToAddress        String?             @map("ship_to_address")
  notes                String?
  internalNotes        String?             @map("internal_notes")
  cancellationReason   String?             @map("cancellation_reason")
  sentAt               DateTime?           @map("sent_at")
  acknowledgedAt       DateTime?           @map("acknowledged_at")
  closedAt             DateTime?           @map("closed_at")
  createdById          Int                 @map("created_by_id")
  approvedById         Int?                @map("approved_by_id")
  approvedAt           DateTime?           @map("approved_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  supplier    Supplier             @relation(fields: [supplierId], references: [id])
  warehouse   Warehouse            @relation(fields: [warehouseId], references: [id])
  requisition PurchaseRequisition? @relation(fields: [requisitionId], references: [id])
  createdBy   User                 @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])
  approvedBy  User?                @relation("PurchaseOrderApprovedBy", fields: [approvedById], references: [id])
  lines       PurchaseOrderLine[]
  receipts    GoodsReceiptNote[]

  @@index([supplierId, status])
  @@index([status])
  @@index([orderDate])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id                Int                     @id @default(autoincrement())
  purchaseOrderId   Int                     @map("purchase_order_id")
  productId         Int                     @map("product_id")
  requisitionLineId Int?                    @map("requisition_line_id")
  lineNumber        Int                     @default(0) @map("line_number")
  description       String?
  quantity          Decimal                 @db.Decimal(18, 4)
  uomId             Int?                    @map("uom_id")
  unitPrice         Decimal                 @map("unit_price") @db.Decimal(18, 4)
  discountPercent   Decimal                 @default(0) @map("discount_percent") @db.Decimal(7, 4)
  taxPercent        Decimal                 @default(0) @map("tax_percent") @db.Decimal(7, 4)
  taxAmount         Decimal                 @default(0) @map("tax_amount") @db.Decimal(18, 2)
  lineTotal         Decimal                 @default(0) @map("line_total") @db.Decimal(18, 2)
  receivedQuantity  Decimal                 @default(0) @map("received_quantity") @db.Decimal(18, 4)
  acceptedQuantity  Decimal                 @default(0) @map("accepted_quantity") @db.Decimal(18, 4)
  rejectedQuantity  Decimal                 @default(0) @map("rejected_quantity") @db.Decimal(18, 4)
  expectedDate      DateTime?               @map("expected_date")
  status            PurchaseOrderLineStatus @default(OPEN)
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  purchaseOrder   PurchaseOrder            @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product                  @relation(fields: [productId], references: [id])
  uom             UnitOfMeasure?           @relation(fields: [uomId], references: [id])
  requisitionLine PurchaseRequisitionLine? @relation(fields: [requisitionLineId], references: [id])
  grnLines        GoodsReceiptLine[]

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_lines")
}

model GoodsReceiptNote {
  id                    Int       @id @default(autoincrement())
  grnNumber             String    @unique @map("grn_number")
  purchaseOrderId       Int?      @map("purchase_order_id")
  supplierId            Int       @map("supplier_id")
  warehouseId           Int       @map("warehouse_id")
  status                GrnStatus @default(DRAFT)
  receivedDate          DateTime  @default(now()) @map("received_date")
  supplierInvoiceNumber String?   @map("supplier_invoice_number")
  supplierInvoiceDate   DateTime? @map("supplier_invoice_date")
  vehicleNumber         String?   @map("vehicle_number")
  lrNumber              String?   @map("lr_number")
  /// True when the receipt happened on or before the PO promised date.
  isOnTime              Boolean?  @map("is_on_time")
  delayDays             Int?      @map("delay_days")
  totalReceivedQuantity Decimal   @default(0) @map("total_received_quantity") @db.Decimal(18, 4)
  totalAcceptedQuantity Decimal   @default(0) @map("total_accepted_quantity") @db.Decimal(18, 4)
  totalRejectedQuantity Decimal   @default(0) @map("total_rejected_quantity") @db.Decimal(18, 4)
  totalValue            Decimal   @default(0) @map("total_value") @db.Decimal(18, 2)
  notes                 String?
  postedAt              DateTime? @map("posted_at")
  receivedById          Int       @map("received_by_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  purchaseOrder PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  supplier      Supplier           @relation(fields: [supplierId], references: [id])
  warehouse     Warehouse          @relation(fields: [warehouseId], references: [id])
  receivedBy    User               @relation("GrnReceivedBy", fields: [receivedById], references: [id])
  lines         GoodsReceiptLine[]
  qualityChecks QualityCheck[]

  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([status])
  @@map("goods_receipt_notes")
}

model GoodsReceiptLine {
  id                  Int       @id @default(autoincrement())
  grnId               Int       @map("grn_id")
  purchaseOrderLineId Int?      @map("purchase_order_line_id")
  productId           Int       @map("product_id")
  lineNumber          Int       @default(0) @map("line_number")
  receivedQuantity    Decimal   @map("received_quantity") @db.Decimal(18, 4)
  acceptedQuantity    Decimal   @default(0) @map("accepted_quantity") @db.Decimal(18, 4)
  rejectedQuantity    Decimal   @default(0) @map("rejected_quantity") @db.Decimal(18, 4)
  uomId               Int?      @map("uom_id")
  unitCost            Decimal   @map("unit_cost") @db.Decimal(18, 4)
  batchNumber         String?   @map("batch_number")
  serialNumbers       String[]  @default([]) @map("serial_numbers")
  manufacturedDate    DateTime? @map("manufactured_date")
  expiryDate          DateTime? @map("expiry_date")
  qcResult            QcResult  @default(PENDING) @map("qc_result")
  rejectionReason     String?   @map("rejection_reason")
  lotId               Int?      @map("lot_id")
  putawayBinId        Int?      @map("putaway_bin_id")
  isPosted            Boolean   @default(false) @map("is_posted")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  grn               GoodsReceiptNote   @relation(fields: [grnId], references: [id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id])
  product           Product            @relation(fields: [productId], references: [id])
  uom               UnitOfMeasure?     @relation(fields: [uomId], references: [id])
  lot               StockLot?          @relation(fields: [lotId], references: [id])
  putawayBin        StorageBin?        @relation(fields: [putawayBinId], references: [id])
  qualityChecks     QualityCheck[]
  putawayTasks      PutawayTask[]

  @@index([grnId])
  @@index([productId])
  @@map("goods_receipt_lines")
}

model QualityCheck {
  id                Int      @id @default(autoincrement())
  qcNumber          String   @unique @map("qc_number")
  grnId             Int      @map("grn_id")
  grnLineId         Int      @map("grn_line_id")
  sampleSize        Decimal  @default(0) @map("sample_size") @db.Decimal(18, 4)
  inspectedQuantity Decimal  @map("inspected_quantity") @db.Decimal(18, 4)
  acceptedQuantity  Decimal  @default(0) @map("accepted_quantity") @db.Decimal(18, 4)
  rejectedQuantity  Decimal  @default(0) @map("rejected_quantity") @db.Decimal(18, 4)
  result            QcResult @default(PENDING)
  defectType        String?  @map("defect_type")
  remarks           String?
  inspectedById     Int      @map("inspected_by_id")
  inspectedAt       DateTime @default(now()) @map("inspected_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  grn         GoodsReceiptNote        @relation(fields: [grnId], references: [id], onDelete: Cascade)
  grnLine     GoodsReceiptLine        @relation(fields: [grnLineId], references: [id], onDelete: Cascade)
  inspectedBy User                    @relation("QualityCheckInspectedBy", fields: [inspectedById], references: [id])
  parameters  QualityCheckParameter[]

  @@index([grnId])
  @@index([result])
  @@map("quality_checks")
}

model QualityCheckParameter {
  id             Int      @id @default(autoincrement())
  qualityCheckId Int      @map("quality_check_id")
  parameterName  String   @map("parameter_name")
  specification  String?
  minValue       Decimal? @map("min_value") @db.Decimal(18, 4)
  maxValue       Decimal? @map("max_value") @db.Decimal(18, 4)
  observedValue  String?  @map("observed_value")
  isPassed       Boolean  @default(false) @map("is_passed")
  createdAt      DateTime @default(now()) @map("created_at")

  qualityCheck QualityCheck @relation(fields: [qualityCheckId], references: [id], onDelete: Cascade)

  @@index([qualityCheckId])
  @@map("quality_check_parameters")
}

// ================================================================
// MODULE 2 — MATERIAL MANAGEMENT: requisitions, issues, production
// ================================================================

model MaterialRequisition {
  id                Int                       @id @default(autoincrement())
  requisitionNumber String                    @unique @map("requisition_number")
  warehouseId       Int                       @map("warehouse_id")
  productionOrderId Int?                      @map("production_order_id")
  status            MaterialRequisitionStatus @default(DRAFT)
  requiredByDate    DateTime?                 @map("required_by_date")
  purpose           String?
  notes             String?
  requestedById     Int                       @map("requested_by_id")
  issuedById        Int?                      @map("issued_by_id")
  issuedAt          DateTime?                 @map("issued_at")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  warehouse       Warehouse                 @relation(fields: [warehouseId], references: [id])
  productionOrder ProductionOrder?          @relation(fields: [productionOrderId], references: [id])
  requestedBy     User                      @relation("MaterialRequisitionRequestedBy", fields: [requestedById], references: [id])
  issuedBy        User?                     @relation("MaterialRequisitionIssuedBy", fields: [issuedById], references: [id])
  lines           MaterialRequisitionLine[]

  @@index([warehouseId, status])
  @@map("material_requisitions")
}

model MaterialRequisitionLine {
  id                Int      @id @default(autoincrement())
  requisitionId     Int      @map("requisition_id")
  productId         Int      @map("product_id")
  requestedQuantity Decimal  @map("requested_quantity") @db.Decimal(18, 4)
  issuedQuantity    Decimal  @default(0) @map("issued_quantity") @db.Decimal(18, 4)
  uomId             Int?     @map("uom_id")
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  requisition MaterialRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  product     Product             @relation(fields: [productId], references: [id])
  uom         UnitOfMeasure?      @relation(fields: [uomId], references: [id])

  @@index([requisitionId])
  @@map("material_requisition_lines")
}

model ProductionOrder {
  id                  Int                   @id @default(autoincrement())
  orderNumber         String                @unique @map("order_number")
  productId           Int                   @map("product_id")
  bomId               Int                   @map("bom_id")
  warehouseId         Int                   @map("warehouse_id")
  status              ProductionOrderStatus @default(DRAFT)
  plannedQuantity     Decimal               @map("planned_quantity") @db.Decimal(18, 4)
  producedQuantity    Decimal               @default(0) @map("produced_quantity") @db.Decimal(18, 4)
  scrappedQuantity    Decimal               @default(0) @map("scrapped_quantity") @db.Decimal(18, 4)
  plannedStartDate    DateTime?             @map("planned_start_date")
  plannedEndDate      DateTime?             @map("planned_end_date")
  actualStartDate     DateTime?             @map("actual_start_date")
  actualEndDate       DateTime?             @map("actual_end_date")
  /// Standard material cost of the run, frozen from the BOM at release.
  plannedMaterialCost Decimal               @default(0) @map("planned_material_cost") @db.Decimal(18, 4)
  /// Actual cost of everything issued against the order.
  actualMaterialCost  Decimal               @default(0) @map("actual_material_cost") @db.Decimal(18, 4)
  notes               String?
  createdById         Int                   @map("created_by_id")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  product              Product                      @relation(fields: [productId], references: [id])
  bom                  BillOfMaterials              @relation(fields: [bomId], references: [id])
  warehouse            Warehouse                    @relation(fields: [warehouseId], references: [id])
  createdBy            User                         @relation("ProductionOrderCreatedBy", fields: [createdById], references: [id])
  components           ProductionOrderComponent[]
  consumption          ProductionOrderConsumption[]
  materialRequisitions MaterialRequisition[]

  @@index([status])
  @@index([productId])
  @@map("production_orders")
}

/// Component demand for a production order, exploded from the BOM at
/// release time so later BOM revisions do not rewrite history.
model ProductionOrderComponent {
  id                Int      @id @default(autoincrement())
  productionOrderId Int      @map("production_order_id")
  productId         Int      @map("product_id")
  requiredQuantity  Decimal  @map("required_quantity") @db.Decimal(18, 4)
  issuedQuantity    Decimal  @default(0) @map("issued_quantity") @db.Decimal(18, 4)
  consumedQuantity  Decimal  @default(0) @map("consumed_quantity") @db.Decimal(18, 4)
  wastedQuantity    Decimal  @default(0) @map("wasted_quantity") @db.Decimal(18, 4)
  scrapPercent      Decimal  @default(0) @map("scrap_percent") @db.Decimal(7, 4)
  standardUnitCost  Decimal  @default(0) @map("standard_unit_cost") @db.Decimal(18, 4)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id])

  @@unique([productionOrderId, productId])
  @@map("production_order_components")
}

/// One issue or scrap event against a production order, at lot granularity,
/// which is what makes consumption-vs-standard and wastage reporting exact.
model ProductionOrderConsumption {
  id                Int      @id @default(autoincrement())
  productionOrderId Int      @map("production_order_id")
  lotId             Int      @map("lot_id")
  quantity          Decimal  @db.Decimal(18, 4)
  /// CONSUMED | WASTED
  consumptionType   String   @map("consumption_type")
  unitCost          Decimal  @map("unit_cost") @db.Decimal(18, 4)
  totalCost         Decimal  @map("total_cost") @db.Decimal(18, 4)
  reasonCode        String?  @map("reason_code")
  occurredAt        DateTime @default(now()) @map("occurred_at")

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  lot             StockLot        @relation(fields: [lotId], references: [id])

  @@index([productionOrderId])
  @@map("production_order_consumption")
}

