{
  "info": {
    "name": "Ralli Wolf API",
    "description": "Security-safe smoke requests. No credentials or bearer tokens are stored in this collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health"
      },
      "response": []
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Start sign-in",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.mfaToken) pm.collectionVariables.set('mfa_token', body.mfaToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            },
            "url": "{{base_url}}/api/auth/login"
          },
          "response": []
        },
        {
          "name": "Verify sign-in code",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.token) pm.collectionVariables.set('staff_token', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Session-Mode",
                "value": "bearer",
                "description": "Explicitly requests a bearer token for this non-browser client. The web app uses an HttpOnly cookie instead."
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mfaToken\": \"{{mfa_token}}\",\n  \"otp\": \"{{login_otp}}\"\n}"
            },
            "url": "{{base_url}}/api/auth/login/otp/verify"
          },
          "response": []
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{staff_token}}",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/api/auth/me"
          },
          "response": []
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 400) pm.collectionVariables.unset('staff_token');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{staff_token}}",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/api/auth/logout"
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:4000",
      "type": "string"
    },
    {
      "key": "admin_email",
      "value": "",
      "type": "string"
    },
    {
      "key": "admin_password",
      "value": "",
      "type": "string"
    },
    {
      "key": "login_otp",
      "value": "",
      "type": "string"
    },
    {
      "key": "mfa_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "staff_token",
      "value": "",
      "type": "string"
    }
  ]
}
