# API Environment Variables
# Copy this file to the API deployment environment and replace placeholders.

# ============================================================
# API — process mode
# ============================================================
NODE_ENV="development"

# ============================================================
# API — required. The server refuses to boot without these.
# ============================================================
DATABASE_URL="postgresql://postgres:password@localhost:5433/innovun_crm?schema=public"

# Dedicated keys; do not reuse one for another.
JWT_SECRET="your-secret-key-here-change-in-production"
OTP_HASH_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES"
TOTP_ENCRYPTION_KEY="REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES"

# Exactly 32 random bytes used to encrypt stored provider credentials.
ENCRYPTION_KEY="base64:REPLACE_WITH_GENERATED_VALUE"

# All application mail. The sender must use a Resend-verified domain.
RESEND_API_KEY="re_your_api_key_here"
RESEND_FROM_EMAIL="Ralli Wolf <otp-noreply@yourdomain.com>"
RESEND_REPLY_TO=""

# ============================================================
# API — server / transport
# ============================================================
PORT=4000
TRUST_PROXY_HOPS=0
CORS_ALLOWED_ORIGINS="http://localhost:3001"
FRONTEND_URL="http://localhost:3001"
JWT_EXPIRES_IN="24h"
KEEPALIVE_TOKEN=""

# ============================================================
# API — storage
# ============================================================
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
S3_BUCKET_NAME=""
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"
S3_USE_ACL="false"
# Public base URL for objects uploaded with publicRead (product/warehouse images).
# Required when the provider serves public files from a different host than the
# S3 API endpoint (Supabase Storage, Cloudflare R2). Supports a {bucket} token.
# Leave empty for plain AWS S3, where the public URL is derived from the bucket.
S3_PUBLIC_BASE_URL=""

# ============================================================
# API — external providers
# ============================================================
MSG91_AUTH_KEY=""
MSG91_OTP_TEMPLATE_ID=""
MSG91_ALLOWED_ORIGINS=""
BREVO_ALLOWED_ORIGINS=""
BREVO_WEBHOOK_SECRET=""
LANDINGI_WEBHOOK_SECRET=""
WHATSAPP_WEBHOOK_SECRET=""
GST_API_KEY=""

# ============================================================
# API — business defaults
# ============================================================
ORDER_PRICE_BOOK_ID=""

# ============================================================
# API — deployment topology
# ============================================================
RUN_EMBEDDED_SCHEDULERS="false"
SCHEDULER_INSTANCE_ID=""

# ============================================================
# LOCAL / CLI — not read by the hosted API process
# ============================================================
DIRECT_URL="postgresql://postgres:password@localhost:5433/innovun_crm?schema=public"
API_URL="http://localhost:4000"

# Destructive seed/reset guards. Production use is blocked.
ALLOW_DESTRUCTIVE_SEED=""
DESTRUCTIVE_DATABASE_CONFIRM=""

# Demo data seeding controls.
ALLOW_DEMO_SEED=""
DEMO_SEED_PASSWORD=""

# ============================================================
# ONE-TIME CLI — set, run bootstrap, then clear
# ============================================================
ALLOW_ADMIN_BOOTSTRAP=""
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_FIRST_NAME=""
BOOTSTRAP_ADMIN_LAST_NAME=""
BOOTSTRAP_ADMIN_PASSWORD=""
